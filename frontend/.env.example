# ============================================================================
#  Frontend (Vite + React) · frontend/.env.example
#  Copy this file to .env . Vite only exposes vars prefixed with VITE_ to the client.
# ============================================================================

# HTTP base for the backend REST API.
# - Local dev: "/api" (Vite dev proxy forwards /api -> VITE_BACKEND_URL).
# - Production cross-origin: the full backend URL, e.g. "https://sol-trade-api.azurewebsites.net/api".
#   This is a BUILD-TIME value (set when running `npm run build` / in the Docker build-arg).
VITE_API_BASE_URL=/api

# Dev-only: the backend origin the Vite dev server proxies /api and /socket.io to.
# Ignored in production builds (nginx.conf handles proxying there).
VITE_BACKEND_URL=http://localhost:3000

# WebSocket base for the realtime trade/offline socket.io stream.
# - Local dev: leave empty -> falls back to window.location.origin (proxy handles /socket.io).
# - Production cross-origin: the backend origin, e.g. "https://sol-trade-api.azurewebsites.net".
VITE_WS_URL=
