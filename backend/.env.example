# Database (Local Supabase - provided by "npx supabase start")
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Redis (local or use Upstash)
REDIS_URL="redis://localhost:6379"

# APIs
CMC_API_KEY="your_coinmarketcap_api_key"
DUNE_API_KEY="your_dune_api_key"

# LLM provider — leave LLM_PROVIDER unset to auto-detect:
#   "azure" wins when AZURE_OPENAI_API_KEY is set (use Nova Program Azure credits),
#   otherwise "openai" uses OPENAI_API_KEY.
LLM_PROVIDER=""
OPENAI_API_KEY="your_openai_api_key"
OPENAI_BASE_URL=""
# Azure OpenAI Service (Nova Program Microsoft Azure credits)
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_INSTANCE_NAME=""
AZURE_OPENAI_API_DEPLOYMENT_NAME="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"
AZURE_OPENAI_BASE_PATH=""
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE="0.3"
ANTHROPIC_API_KEY="your_anthropic_api_key"

# NestJS
NODE_ENV="development"
PORT="3000"

# Injective (Nova Program cross-chain integration)
# Enable Injective Helix market data + MCP execution layer.
ENABLE_INJECTIVE="false"
INJECTIVE_NETWORK="testnet"
INJECTIVE_EXCHANGE_API="https://api.injective.exchange"
# Official Injective MCP server command (spawned as stdio child process).
INJECTIVE_MCP_BIN="npx -y @injectivelabs/mcp-server"
# Mnemonic for the Injective account that signs trades via MCP.
# Leave empty to use the MockInjectiveTradeExecutor (simulated tx hashes, no signing).
INJECTIVE_MNEMONIC=""
# Optional override of Helix market ids, e.g. "INJ/USDC=INJ/USDC:spot,INJ/USDT=INJ/USDT:spot"
INJECTIVE_HELI_MARKETS=""

# --- Injective Agent Identity (ERC-8004) ---
# Our agent's on-chain identity card. Without INJECTIVE_AGENT_ID the service
# returns a deterministic simulated card; with it, the real on-chain record is
# fetched from the Injective Identity Registry (read-only, via viem).
INJECTIVE_AGENT_NAME="Solana<->Injective Cross-Chain Quant Agent"
INJECTIVE_AGENT_TYPE="trading"
INJECTIVE_AGENT_BUILDER_CODE="nova-sol-trade-agent"
INJECTIVE_AGENT_DESCRIPTION="Autonomous cross-chain arbitrage agent between Solana DEXs and Injective Helix, exposing an MCP endpoint for natural-language quant assistance."
INJECTIVE_AGENT_ID=""                 # a real registered agentId (decimal string) -> live card
INJECTIVE_AGENT_PRIVATE_KEY=""        # EVM key for the agent identity wallet (optional)
INJECTIVE_AGENT_REGISTRY_ENABLED="false"  # set true for a live registry scan in /agent/registry
INJECTIVE_AGENT_SCAN_FROM_BLOCK=""    # override scan start block (decimal)
INJECTIVE_AGENT_SCAN_MAX_CHUNKS="6"
INJECTIVE_AGENT_SCAN_CHUNK_SIZE="20000"
PINATA_JWT=""                         # for real on-chain Agent Card upload (registration)

# Public URL of THIS backend's MCP endpoint (declared in our Agent Card services).
MCP_PUBLIC_URL="http://localhost:3000/mcp"
A2A_PUBLIC_URL=""
