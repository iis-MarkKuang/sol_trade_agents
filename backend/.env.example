# ============================================================================
#  Solana <-> Injective Cross-Chain Quant Agent  ·  backend/.env.example
#  ✅ = required   💡 = optional (demo runs with these empty)
#  Copy this file to .env and fill in your own keys. .env is gitignored.
#  Only DATABASE_URL is strictly required for a minimal demo; everything else
#  has a safe default or falls back to mock.
# ============================================================================

# ---------------------------- Infrastructure ----------------------------
# ✅ Postgres connection string. Locally: `npx supabase start` then use this.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# 💡 Redis for BullMQ queues. Local: `docker compose up -d redis`. Leave empty if you don't use queues.
REDIS_URL="redis://localhost:6379"

# 💡 NestJS
NODE_ENV="development"
PORT="3000"

# 💡 Frontend origin (CORS allow-list). Local Vite default is 5173.
#    In production set this to your frontend public URL (e.g. https://app.azurestaticapps.net).
FRONTEND_URL="http://localhost:5173"

# ---------------------------- LLM provider (pick one) ----------------------------
# If ALL LLM keys are empty -> mock LLM fallback (deterministic output, demo still works).
# LLM_PROVIDER (optional, enum: "deepseek" | "openai" | "azure"). If unset:
#   - "azure" wins when AZURE_OPENAI_API_KEY is set (use Nova Program Azure credits),
#   - then "deepseek" when DEEPSEEK_API_KEY is set,
#   - otherwise "openai" uses OPENAI_API_KEY.
LLM_PROVIDER="deepseek"
# Optional global model override. Prefer the provider-specific model variables below.
# LLM_MODEL=""
LLM_TEMPERATURE="0.3"
LLM_MAX_OUTPUT_TOKENS="512"                   # hard cap per request across all providers

# ---- Path A: DeepSeek direct API ----
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# ---- Path B: OpenAI direct API ----
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"

# ---- Path C (works from mainland China): OpenRouter gateway ----
# One key aggregates many models via an OpenAI-compatible endpoint.
# Get a key at https://openrouter.ai/keys, fill the two lines below.
#
# ⚠️  CN IP note: openai/* and anthropic/* on OpenRouter are often 403 (upstream ToS).
#     Use deepseek/* for Ask Agent (tool calling). The backend auto-skips blocked models.
#     Verified tool-calling models: deepseek/deepseek-chat-v3-0324, deepseek/deepseek-chat
#     Plain chat (Insights LLM): mistralai/mistral-small-24b-instruct-2501 also works.
# LLM_PROVIDER="openai"
# OPENAI_API_KEY="your_openrouter_api_key"
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# LLM_MODEL="deepseek/deepseek-chat-v3-0324"

# ---- Path D: Azure OpenAI (Nova credits; CN personal accounts usually blocked) ----
# LLM_PROVIDER="azure"
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_API_INSTANCE_NAME=""            # Azure resource name
# AZURE_OPENAI_API_DEPLOYMENT_NAME="gpt-4o-mini"  # deployment name (not model name)
# AZURE_OPENAI_API_VERSION="2024-08-01-preview"
# AZURE_OPENAI_BASE_PATH=""

# ---------------------------- Decision provider / quality gate ----------------------------
# Decision models are separate from generative LLMs. With "none", the pipeline
# behaves exactly as before. Start JEV in shadow mode before enabling enforcement.
DECISION_PROVIDER="none"                       # none | jev
TYPESAFE_API_KEY=""
JEV_API_BASE_URL="https://api.typesafe.ai"
JEV_MODEL="jev-1.13.0"                         # pin a model version for reproducibility
JEV_TIMEOUT_MS="1500"
JEV_QUALITY_GATE_MODE="shadow"                 # disabled | shadow | enforce
JEV_QUALITY_GATE_MIN_CONFIDENCE="0.75"

# ---------------------------- UsageLedger (cost controls, 💡 optional) ----------------------------
# Provider-neutral, restart-safe, multi-instance usage ledger. PG is the source
# of truth; Redis caches daily aggregates for the hot-path budget check.
# See docs/usage-ledger-design.md and docs/usage-ledger-roadmap.md.
# Defaults are PLACEHOLDERS pending OP-14; the flag defaults off so current
# behavior (in-process Dune budget, log-only LLM usage, no CMC daily cap) is
# unchanged until the operator turns this on and resolves OP-11..OP-15.
USAGE_LEDGER_ENABLED="false"
USAGE_LEDGER_DUNE_HARD_LIMIT_PER_DAY="8"      # executions per UTC day
USAGE_LEDGER_DUNE_WARNING_PCT="80"             # warn at N% of hard limit
USAGE_LEDGER_CMC_HARD_LIMIT_PER_DAY="1000"    # credits/requests (unit TBD, OP-13)
USAGE_LEDGER_CMC_WARNING_PCT="80"
USAGE_LEDGER_LLM_HARD_LIMIT_PER_DAY="50000"   # tokens per UTC day
USAGE_LEDGER_LLM_WARNING_PCT="80"
USAGE_LEDGER_JEV_HARD_LIMIT_PER_DAY="50000"   # tokens per UTC day
USAGE_LEDGER_JEV_WARNING_PCT="80"

# ---------------------------- Data crawlers (💡 optional) ----------------------------
# CoinMarketCap can fall back; Dune fails closed unless DUNE_USE_MOCK=true.
# NOTE: the code reads COINMARKETCAP_API_KEY (NOT CMC_API_KEY).
COINMARKETCAP_API_KEY=""
COINMARKETCAP_CACHE_TTL_MS="600000"            # 10 min; avoids repeated listing credits
DUNE_API_KEY=""
DUNE_API_BASE_URL="https://api.dune.com/api"
# Comma-separated Dune chain names. "robinhood" means Robinhood Chain,
# not centralized Robinhood App trading activity.
DUNE_CHAINS="solana,ethereum,base,arbitrum,optimism,polygon,bnb,robinhood"
DUNE_LOOKBACK_HOURS="24"
DUNE_RESULT_LIMIT="100"
DUNE_QUERY_TIMEOUT_MS="120000"
DUNE_PERFORMANCE=""                            # optional: small | medium | large
DUNE_CACHE_TTL_MS="10800000"                   # 3h; Dune is a research source
DUNE_MAX_EXECUTIONS_PER_DAY="8"                # per backend process, resets at UTC midnight
DUNE_USE_MOCK="false"                          # true only for explicit demos/tests

# Node does not automatically inherit the macOS system proxy. Set this only
# when outbound APIs require a local proxy, for example http://127.0.0.1:7897.
# HTTPS_PROXY=""

# ---------------------------- Solana DEX / Pyth / risk engine (💡 optional) ----------------------------
# All have safe defaults; only set to go live. Real Jupiter/Raydium/Orca are gated behind ENABLE_REAL_DEX.
ENABLE_REAL_DEX="false"                        # true -> use real DEX adapters instead of mock
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"  # RPC for live DEX adapters
JUPITER_API_KEY=""
ORCA_WALLET_PUBLIC_KEY=""                      # 💡 Required by the Orca Whirlpool adapter
ORCA_POOLS_BY_PAIR=""                          # 💡 e.g. "SOL/USDC=<whirlpool-address>,USDC/USDT=<addr>"

# Pyth Hermes price feeds
PYTH_HERMES_ENDPOINT="https://hermes.pyth.network"
PYTH_STALE_MS="15000"                          # reject feeds older than N ms
PYTH_MAX_CONFIDENCE_BPS="75"                   # reject prices with confidence band wider than N bps
# 💡 Force deterministic mock Pyth prices (reference USD per asset). Set "true"
#    for a reliable demo — hermes.pyth.network can be TLS-blocked for Node fetch
#    on some networks (curl works, Node doesn't), which crashes prepareTrade.
#    With mock, the cache is filled with clean reference prices. Set "false" to
#    attempt the live Pyth feed (auto-falls back to mock if the probe fails).
PYTH_USE_MOCK="false"

# Risk-engine policy caps
MAX_SLIPPAGE_BPS="100"
MAX_POSITION_NOTIONAL_USD="25000"
MIN_LIQUIDITY_USD="1000"
MAX_ORACLE_DEVIATION_BPS="150"                 # reject quotes too far from oracle mid
MAX_PRICE_IMPACT_BPS="100"
MAX_QUOTE_AGE_MS="5000"                        # reject stale DEX quotes
DEX_QUOTE_TIMEOUT_MS="2500"                    # per-adapter quote timeout
REALTIME_RETRIES="2"                           # retry attempts on realtime execution

# ---------------------------- Injective integration (💡 optional, demo-safe) ----------------------------
# Registers Helix market-data adapter + Injective execution layer.
# No mnemonic -> MockInjectiveTradeExecutor (simulated tx hashes, zero fund risk);
# with mnemonic -> MCP signs real testnet trades.
ENABLE_INJECTIVE="true"
INJECTIVE_NETWORK="testnet"                    # testnet | mainnet
INJECTIVE_EXCHANGE_API="https://api.injective.exchange"
# Official Injective MCP server command (spawned as a stdio child process).
INJECTIVE_MCP_BIN="npx -y @injectivelabs/mcp-server"
INJECTIVE_MNEMONIC=""
# Optional override of Helix market ids, e.g. "INJ/USDC=INJ/USDC:spot,BTC/USDT=BTC/USDT:derivative"
INJECTIVE_HELI_MARKETS=""

# ---------------------------- Monad integration (💡 optional, demo-safe) ----------------------------
# Registers a Monad (EVM-compatible L1, chain id 143 mainnet / 10143 testnet) DEX
# adapter + viem-based executor. No private key -> MockMonadTradeExecutor
# (simulated tx hashes, zero fund risk); with key -> real EVM signing via viem.
# The DEX adapter uses an aggregator API (0x/1inch) when a key is set, else a
# deterministic mock fallback tracking the Pyth oracle mid + a small premium.
ENABLE_MONAD="false"
MONAD_NETWORK="mainnet"                       # mainnet (143) | testnet (10143)
MONAD_RPC_URL="https://rpc.monad.xyz"          # public RPC is rate-limited; use a provider in prod
MONAD_PRIVATE_KEY=""                          # 💡 EVM private key; empty -> mock executor
MONAD_DEX_MODE="0x"                            # 0x | 1inch | uniswap_v3 | mock
ZEROX_API_KEY=""                              # 💡 0x Swap API key (Monad-supported)
ONEINCH_API_KEY=""                             # 💡 1inch API key
MONAD_MOCK_PREMIUM_BPS="30"                    # deterministic Monad premium used by the mock fallback

# ---------------------------- Injective Agent Identity (ERC-8004) (💡 optional) ----------------------------
# Our agent's on-chain identity card.
# Without INJECTIVE_AGENT_ID -> deterministic simulated card;
# with it -> the real on-chain record is fetched from the Injective Identity Registry (read-only, via viem).
INJECTIVE_AGENT_NAME="Solana<->Injective Cross-Chain Quant Agent"
INJECTIVE_AGENT_TYPE="trading"
INJECTIVE_AGENT_BUILDER_CODE="nova-sol-trade-agent"
INJECTIVE_AGENT_DESCRIPTION="Autonomous cross-chain arbitrage agent between Solana DEXs and Injective Helix, exposing an MCP endpoint for natural-language quant assistance."
INJECTIVE_AGENT_ID=""                          # 💡 a registered agentId (decimal string) -> live card
INJECTIVE_AGENT_PRIVATE_KEY=""
INJECTIVE_AGENT_REGISTRY_ENABLED="false"       # true -> /agent/registry does a live on-chain scan
INJECTIVE_AGENT_SCAN_FROM_BLOCK=""             # 💡 scan start block (decimal); empty = network default deployBlock
INJECTIVE_AGENT_SCAN_MAX_CHUNKS="6"
# ⚠️ mainnet sentry RPC caps eth_getLogs at 10k blocks; 20k chunks get rejected
#    (silently yields 0 agents). Use 10000 for mainnet, 20000 is fine for testnet.
INJECTIVE_AGENT_SCAN_CHUNK_SIZE="10000"
# 💡 mainnet demo: set INJECTIVE_NETWORK="mainnet", FROM_BLOCK="162000000", MAX_CHUNKS="20"
#    to surface ~46 real Nova agents registered right after the registry deploy block.
PINATA_JWT=""

# ---------------------------- Our own MCP endpoint (💡 optional) ----------------------------
# Declared in our Agent Card services so other Injective agents can discover and call us.
# Use localhost for local demo; in production set this to the backend public URL.
MCP_PUBLIC_URL="http://localhost:3000/mcp"
A2A_PUBLIC_URL=""
